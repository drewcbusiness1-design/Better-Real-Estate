# Local dev only. In production set these in Netlify → Environment variables.

# Database — `netlify db init` sets NETLIFY_DATABASE_URL automatically.
DATABASE_URL=postgres://user:pass@127.0.0.1:5432/bredb

SESSION_SECRET=generate-with-openssl-rand-base64-32
APP_URL=http://localhost:8888

# Only these emails can reach the admin panel, suppliers and fulfilment queue.
ADMIN_EMAILS=drewcbusiness1@gmail.com

# Email — resend.com. MAIL_FROM must be a domain YOU verified, never gmail.com.
# See GOLIVE.md step 2 for why.
RESEND_API_KEY=
MAIL_FROM=Better Real Estate <noreply@yourdomain.com>
MAIL_REPLY_TO=drewcbusiness1@gmail.com

# Payments — all three, or leave all blank for simulated mode.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
