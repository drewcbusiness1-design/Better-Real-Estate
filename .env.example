# Better Real Estate environment template — never commit real secrets.
DATABASE_URL=
NETLIFY_DATABASE_URL=
SESSION_SECRET=
APP_URL=
ADMIN_EMAILS=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
MAIL_FROM=
# Optional explicit sender overrides; both addresses must be on the verified Resend domain.
MAIL_NOTIFICATIONS_FROM=Better Real Estate <notifications@betterrealestate.org>
MAIL_PARTNERS_FROM=Better Real Estate <partners@betterrealestate.org>
MAIL_REPLY_TO=partners@betterrealestate.org
MAIL_REPLY_TO=
MARKETING_EMAILS_ENABLED=false
MARKETING_POSTAL_ADDRESS=
CJ_API_KEY=
GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: override the low-cost Deal Intelligence web-research model.
OPENAI_RESEARCH_MODEL=
PORT=8888
# Optional authorized MLS / RESO Web API. Better never scrapes MLS/Zillow websites.
MLS_RESO_NAME=
MLS_RESO_BASE_URL=
MLS_RESO_TOKEN=
# Optional JSON array for multiple authorized feeds.
MLS_RESO_SOURCES_JSON=

# v29.11 live parcel/property facts (configured in Netlify; never expose client-side)
REGRID_API_TOKEN=
# Optional Enterprise-only rescue. Leave false/unset unless your Regrid plan includes Typeahead.
REGRID_USE_TYPEAHEAD=false
